[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/goline_ai/goline_dock.gd" id="1_dock"]

[node name="GolineAIDock" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_dock")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 8
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 8
theme_override_constants/margin_bottom = 8

[node name="Box" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Margin/Box"]
layout_mode = 2
text = "Goline AI"
theme_override_font_sizes/font_size = 15

[node name="CLIBox" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2

[node name="CLILabel" type="Label" parent="Margin/Box/CLIBox"]
layout_mode = 2
text = "CLI:"

[node name="CLIPath" type="LineEdit" parent="Margin/Box/CLIBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "path to goline_cli.py"

[node name="AutoBtn" type="Button" parent="Margin/Box/CLIBox"]
layout_mode = 2
text = "Auto"

[node name="ProvBox" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2

[node name="ProvLabel" type="Label" parent="Margin/Box/ProvBox"]
layout_mode = 2
text = "Provider:"

[node name="Provider" type="OptionButton" parent="Margin/Box/ProvBox"]
unique_name_in_owner = true
layout_mode = 2

[node name="Actions" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2

[node name="ExplainBtn" type="Button" parent="Margin/Box/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Explain file"

[node name="EditBtn" type="Button" parent="Margin/Box/Actions"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Edit file"

[node name="Instruction" type="LineEdit" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "Instruction for Edit (e.g. add _process that prints velocity)"

[node name="ErrLabel" type="Label" parent="Margin/Box"]
layout_mode = 2
text = "Paste error / backtrace:"

[node name="ErrorText" type="TextEdit" parent="Margin/Box"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
placeholder_text = "ERROR: ...\n   at res://scripts/player.gd:12"
wrap_mode = 1

[node name="DebugBtn" type="Button" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = "Debug error"

[node name="Sep" type="HSeparator" parent="Margin/Box"]
layout_mode = 2

[node name="OutLabel" type="Label" parent="Margin/Box"]
layout_mode = 2
text = "Output:"

[node name="Output" type="RichTextLabel" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
scroll_following = true
bbcode_enabled = false

[node name="Status" type="Label" parent="Margin/Box"]
unique_name_in_owner = true
layout_mode = 2
text = ""

[node name="Under" type="HBoxContainer" parent="Margin/Box"]
layout_mode = 2

[node name="CopyBtn" type="Button" parent="Margin/Box/Under"]
layout_mode = 2
text = "Copy output"

[node name="Space" type="Control" parent="Margin/Box/Under"]
layout_mode = 2
size_flags_horizontal = 3

[connection signal="pressed" from="Margin/Box/CLIBox/AutoBtn" to="." method="_on_auto_pressed"]
[connection signal="pressed" from="Margin/Box/Actions/ExplainBtn" to="." method="_on_explain_pressed"]
[connection signal="pressed" from="Margin/Box/Actions/EditBtn" to="." method="_on_edit_pressed"]
[connection signal="pressed" from="Margin/Box/DebugBtn" to="." method="_on_debug_pressed"]
[connection signal="pressed" from="Margin/Box/Under/CopyBtn" to="." method="_on_copy_pressed"]